<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.platformer</groupId>
  <artifactId>platformer2d</artifactId>
  <version>1.0.0</version>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <exec.mainClass>com.platformer.Launcher</exec.mainClass>
    <javafx.version>21.0.4</javafx.version>
    
    <!-- Properti untuk nama file JAR -->
    <project.build.finalName>${project.artifactId}-${project.version}</project.build.finalName>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-media</artifactId>
      <version>${javafx.version}</version>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>assets</directory>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>com.platformer.Launcher</mainClass>
        </configuration>
      </plugin>

      <!-- Plugin "Fat JAR" Anda (tetap diperlukan) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.platformer.Launcher</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 
        PLUGIN BARU: Untuk menjalankan jpackage dan membuat .exe
        Ini akan berjalan setelah 'package' (saat JAR sudah dibuat)
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>run-jpackage</id>
            <!-- Ikat ke fase 'verify' agar berjalan SETELAH 'package' -->
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <!-- Path ke 'jpackage' (ada di dalam folder /bin/ JDK 21 Anda) -->
              <executable>jpackage</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>--type</argument>
                <argument>exe</argument>
                
                <argument>--name</argument>
                <argument>MariaAdventurer</argument> <!-- Nama aplikasi Anda -->
                
                <argument>--app-version</argument>
                <argument>${project.version}</argument>
                
                <argument>--vendor</argument>
                <argument>Platformer2D Team</argument> <!-- Nama Anda/Tim Anda -->
                
                <argument>--dest</argument>
                <argument>target/installer</argument> <!-- Folder output -->
                
                <argument>--input</argument>
                <argument>target</argument> <!-- Folder input (tempat .jar berada) -->
                
                <argument>--main-jar</argument>
                <argument>${project.build.finalName}.jar</argument> <!-- Nama file JAR Anda -->
                
                <argument>--main-class</argument>
                <argument>com.platformer.Launcher</argument>
                
                <argument>--icon</argument>
                <argument>assets/icons/icon.ico</argument> <!-- Path ke ikon .ico Anda -->
                
                <!-- Ini akan memperbaiki warning 'restricted method' di log Anda -->
                <argument>--java-options</argument>
                <argument>--enable-native-access=javafx.graphics,javafx.media</argument>
                
                <!-- Opsi Windows -->
                <argument>--win-shortcut</argument>
                <argument>--win-menu</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>
</project>