<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.platformer</groupId>
  <artifactId>platformer2d</artifactId>
  <version>1.0.0</version>
  <build>
    <resources>
      <resource>
        <directory>assets</directory>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>com.platformer.Launcher</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>com.platformer.Launcher</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>run-jpackage</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>jpackage</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>--type</argument>
                <argument>exe</argument>
                <argument>--name</argument>
                <argument>MariaAdventurer</argument>
                <argument>--app-version</argument>
                <argument>${project.version}</argument>
                <argument>--vendor</argument>
                <argument>Platformer2D Team</argument>
                <argument>--dest</argument>
                <argument>target/installer</argument>
                <argument>--input</argument>
                <argument>target</argument>
                <argument>--main-jar</argument>
                <argument>${project.build.finalName}.jar</argument>
                <argument>--main-class</argument>
                <argument>com.platformer.Launcher</argument>
                <argument>--icon</argument>
                <argument>assets/icons/icon.ico</argument>
                <argument>--java-options</argument>
                <argument>--enable-native-access=javafx.graphics,javafx.media</argument>
                <argument>--win-shortcut</argument>
                <argument>--win-menu</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <properties>
    <project.build.finalName>${project.artifactId}-${project.version}</project.build.finalName>
    <javafx.version>21.0.4</javafx.version>
    <maven.compiler.target>21</maven.compiler.target>
    <exec.mainClass>com.platformer.Launcher</exec.mainClass>
    <maven.compiler.source>21</maven.compiler.source>
  </properties>
</project>
